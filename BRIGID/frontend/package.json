{
  "name": "brigid",
  "version": "1.0.0",
  "description": "BRIGID RTLS Desktop Platform",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/run-electron-vite.cjs dev",
    "build": "node scripts/run-electron-vite.cjs build",
    "preview": "node scripts/run-electron-vite.cjs preview",
    "postinstall": "electron-builder install-app-deps",
    "package": "npm run build && electron-builder --win --config",
    "package:dir": "npm run build && electron-builder --win --dir --config"
  },
  "dependencies": {
    "@blueprintjs/core": "^5.13.0",
    "@blueprintjs/icons": "^5.13.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource/inter": "^5.2.8",
    "motion": "^12.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/packager": "^19.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
